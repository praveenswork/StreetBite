rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == vendorId;
      allow update, delete: if isOwner(vendorId);
    }

    match /vendors/{vendorId}/menuItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isOwner(vendorId);
    }

    match /vendors/{vendorId}/inventory/{itemId} {
      allow read: if true;
      allow create, update, delete: if isOwner(vendorId);
    }

    match /vendors/{vendorId}/orders/{orderId} {
      allow read: if isOwner(vendorId);
      allow create: if true;
      allow update, delete: if isOwner(vendorId);
    }
  }
}